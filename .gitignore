# Generated graph data and experiment artefacts
embeddings_init/
results/
# Keep only the small inverse-relation resolver needed to reproduce graph variants.
datasets/UMLS-NCI/*
!datasets/UMLS-NCI/rela_inverse_resolver.xlsx
datasets/UMLS_nci_kg*.json
datasets/*scale_matched*.json
datasets/semantic_type_integrations/
datasets/get_without_50_reverse_ing/
datasets/archive/
datasets/split/*.npy

# Large or generated serialisations are ignored by default.
*.json
*.jsonl
*.pickle
*.pkl
*.pt
*.ckpt
*.csv
*.xls
*.xlsx
*.zip

# Exception to the generic Excel rule above: needed for UMLS inverse filtering.
!datasets/UMLS-NCI/rela_inverse_resolver.xlsx

# Small, redistributable TDG benchmark inputs.
!datasets/GT2KG_kg.json
!datasets/GT2KG_kg_raw.json
!datasets/KG_GEN_kg.json
!datasets/KG_GEN_kg_raw.json
!datasets/common_nodes.xlsx
!datasets/split/split_*.json
!datasets/semantic_type_integrations/
!datasets/semantic_type_integrations/umls_nci_clean_1pct_common_terms.json

__pycache__/
*.pyc
.pytest_cache/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Optional local keys
*.pub

# Local paper, release, and generated-artifact workspaces. These remain on
# disk but are not part of the source repository.
/TDGBench_v1.0/
/DBpedia_Results/
/paper_tables/
/graphs_stats/
/preview*.aux
/preview*.log
/preview*.pdf
/preview*.png

# RDF is exported from the JSON graph files by the supplied generation
# scripts; do not version the large derived serialisations.
/datasets/*.rdf

# Temporary directories created by graph-variant tests.
/tests/tmp*/
